# ==============================================================================
#                    🎮 DARKONYX PANEL CONFIGURATION (.env)
# ==============================================================================

# Node Environment ('production' or 'development')
NODE_ENV=production

# Service Listening Ports
PORT_WEB=3001
PORT_API=3003
PORT_SFTP=3004

# ------------------------------------------------------------------------------
# Database
#   DB_DRIVER=sqlite -> zero-config embedded database (recommended, no services)
#   DB_DRIVER=mysql  -> MariaDB / MySQL (classic M-panel stack)
# ------------------------------------------------------------------------------
DB_DRIVER=sqlite
DB_FILE=./data/darkonyx.sqlite3

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=panel
DB_PASSWORD=PanelPass123!
DB_NAME=darkonyx

# JWT Authentication Security Secret & Expiration
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# CurseForge Core API Key & Base URL for Modpacks & Plugins
CURSEFORGE_API_KEY=$2a$10$2LouREiMl.mx0kVBK.RlK.nloje4XS3oF8uSw809VZr07O.0A5cLq
CURSEFORGE_BASE_URL=https://api.curseforge.com/v1

# Virtualization mode for VM eggs ('on', 'off' for No-KVM software emulation, or 'auto')
VM_KVM_MODE=auto
